#!name=G1 ACQ (Loon 适配)
#!desc=基于 crhywun/g1-acq v7.5.0 的非官方 Loon 配置适配。使用原作者脚本，采集原始 Google One SKU、三档改写和本地报告。无全局 UDP 443 拦截。
#!author=crhywun (原脚本); Loon 配置适配 (非官方)
#!homepage=https://github.com/crhywun/g1-acq
#!system=iOS

[Script]
# 官方脚本（响应）：先采集原始 SKU，然后仅在 /ai? 路径进行商品编号替换
http-response ^https:\/\/one\.google\.com\/ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-acq.js,requires-body=true,tag=G1-ACQ-SKU,enable=true,timeout=20
# 官方脚本（请求）：本机生成 https://one.google.com/g1-sku-report 页面
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-sku-report.js,tag=G1-ACQ-Report,enable=true,timeout=20

[Mitm]
hostname = one.google.com
