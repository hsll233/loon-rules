#!name=小红书｜首页视频过滤
#!desc=过滤首页推荐与趋势流中的视频内容，仅保留图文等非视频项目；兼容新版/旧版 Loon，并包含 QUIC 回落与 MITM 配置
#!author=ChatGPT
#!date=2026-09-16

[Rule]
AND,((DOMAIN-SUFFIX,xiaohongshu.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,xhscdn.com),(PROTOCOL,QUIC)),REJECT
AND,((IP-CIDR,121.227.107.0/24,no-resolve),(PROTOCOL,QUIC)),REJECT

[Script]
http-response ^https?:\/\/[^\/]+\/api\/sns\/v\d+\/(homefeed|trending) script-path=https://raw.githubusercontent.com/hsll233/loon-rules/main/scripts/xhs_filter_home_videos.js,requires-body=true,timeout=20,tag=XHS_Filter_Home_Videos

[MITM]
hostname = rec.xiaohongshu.com, edith.xiaohongshu.com, *.xhscdn.com, *.xiaohongshu.com, 121.227.107.*
