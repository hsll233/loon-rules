#!name=小红书禁止连续上滑视频
#!desc=拦截小红书视频详情页继续获取下一条视频；尽量保留主页/搜索视频的正常打开
#!author=ChatGPT
#!date=2026-09-16

[Rewrite]
^https?:\/\/rec\.xiaohongshu\.com\/.*video.* - reject-dict

# 备用规则：如果上面的 rec.xiaohongshu.com 规则无效，再取消下面这一行前面的 #。
# 注意：这个接口更激进，可能影响部分正常视频加载。
# ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v3\/note\/videofeed.* - reject-dict

[MITM]
hostname = rec.xiaohongshu.com

# 如果启用上面的备用 videofeed 规则，同时把上一行改为：
# hostname = rec.xiaohongshu.com, edith.xiaohongshu.com
